# HiveOS environment — copy to .env and fill in. Secrets ONLY here.
# (referenced by scripts/setup.sh; loaded by src/hive/core/config.py)

# --- Executor provider (minimax | anthropic) ---
HIVE_EXEC_PROVIDER=minimax

# --- MiniMax (primary executor) ---
MINIMAX_API_KEY=
MINIMAX_ANTHROPIC_BASE=https://api.minimax.io/anthropic
MINIMAX_OPENAI_BASE=https://api.minimax.io/v1
HIVE_EXEC_MODEL=MiniMax-M3
HIVE_EXEC_FALLBACK_MODEL=MiniMax-M2.7
HIVE_AUX_MODEL=MiniMax-M2.7
HIVE_REMAINS_URL=https://api.minimax.io/v1/token_plan/remains

# --- Anthropic (alternative executor; used when HIVE_EXEC_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY may be comma-separated for multi-key failover.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE=https://api.anthropic.com

# --- Storage (defaults derive from the repo root; override to relocate) ---
HIVE_DATA_DIR=
HIVE_STATE_DB=

# --- ChatGPT Plus planner (heavy planning only, via Codex OAuth) ---
HIVE_PLANNER_ENABLED=false
HIVE_PLANNER_CMD=codex exec
HIVE_PLANNER_TIMEOUT=120

# --- Gateway ---
HIVE_HOST=0.0.0.0
HIVE_PORT=8088
HIVE_SECRET=change_me
# Set true for a deployed gateway. Startup then rejects the default HIVE_SECRET.
HIVE_PRODUCTION=false

# --- Memory ---
# MNEMOSYNE_HOME: writable dir for the local Mnemosyne SQLite DB.
#   Leave blank to use <HIVE_DATA_DIR>/mnemosyne (default).
#   Set to point an existing Mnemosyne install.
MNEMOSYNE_HOME=
# MNEMOSYNE_MCP_URL: MCP endpoint of a remote Mnemosyne server (future; unused today).
MNEMOSYNE_MCP_URL=
OBSIDIAN_VAULT_PATH=

# --- Autonomy ---
# Safety gates: keep both false until durable approvals, task recovery and backups are configured.
HIVE_AUTONOMY_ENABLED=false
HIVE_AUTONOMOUS_SELFMOD_ENABLED=false
HIVE_HEARTBEAT_SEC=900
HIVE_MAX_AGENTS=3

# --- Agent limits (tunable without code changes) ---
# Maximum tool-loop iterations per turn (default: 30)
# HIVE_MAX_ITERATIONS=30
# Maximum calls to a single tool per session (default: 50)
# HIVE_MAX_PER_TOOL=50
# Failure count before the self-improvement loop triggers (default: 3)
# HIVE_SELFMOD_THRESHOLD=3
# Timeout in seconds for individual tool calls (default: 60)
# HIVE_TOOL_TIMEOUT=60

# Shell execution backend: "local" (default, runs in host process) or "docker"
# (runs each shell command in a disposable container — network/filesystem isolation).
# HIVE_SHELL_PROVIDER=local
# Docker image used when HIVE_SHELL_PROVIDER=docker
# HIVE_SHELL_DOCKER_IMAGE=alpine:latest

# Gateway security
# HIVE_CORS_ORIGINS=*                  # Allowed CORS origins (comma-separated, or * for all)
# HIVE_MAX_MESSAGE_LEN=32000           # Max chat message length in characters
# HIVE_WS_IDLE_TIMEOUT=300             # WebSocket idle timeout in seconds

# --- Budgeter ---
HIVE_DAILY_CALL_CAP=3000
HIVE_WINDOW_WARN_PCT=70

# --- Hive's own GitHub identity ---
HIVE_GITHUB_TOKEN=
HIVE_GITHUB_REPO=
HIVE_GITHUB_OWNER=

# --- Telegram surface (optional) ---
# Bot token from @BotFather; webhook secret is the X-Telegram-Bot-Api-Secret-Token
# you pass to setWebhook (verified on every inbound update).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Required when TELEGRAM_BOT_TOKEN enables the inbound webhook. Comma-separated IDs.
HIVE_TELEGRAM_ALLOWED_USER_IDS=
HIVE_TELEGRAM_ALLOWED_CHAT_IDS=

# --- Multi-channel messaging (ExternalMessage tool) ---
# Email (SMTP) — all four must be set for email to work (uses STARTTLS on port 587)
# HIVE_SMTP_HOST=smtp.gmail.com
# HIVE_SMTP_PORT=587
# HIVE_SMTP_USER=your@gmail.com
# HIVE_SMTP_PASS=your-app-password
# HIVE_SMTP_TO=kamil@example.com
# Slack incoming webhook — set to enable Slack notifications
# HIVE_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# Discord incoming webhook — set to enable Discord notifications
# HIVE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# --- Inbound sender allowlists ---
# Each enabled inbound channel requires its allowlist at startup. IDs are comma-separated.
# HIVE_SLACK_ALLOWED_USER_IDS=U0123456789
# HIVE_DISCORD_ALLOWED_USER_IDS=123456789012345678
# HIVE_EMAIL_ALLOWED_SENDERS=kamil@example.com

# --- Self-mod sandbox (optional) ---
# Docker image to run candidate self-mod test suites in (isolated, no network).
# Leave blank to run tests locally.
HIVE_SANDBOX_IMAGE=

# --- MCP servers (optional) ---
# ';'-separated specs loaded into the tool registry at gateway/heartbeat startup. Each
# is a stdio command line OR an http(s):// URL (SSE transport). MNEMOSYNE_MCP_URL (above)
# is loaded the same way. Hive can also expose its own tools: `hive mcp-serve`. Example:
#   HIVE_MCP_SERVERS=npx -y @modelcontextprotocol/server-filesystem /data;https://remote/sse
HIVE_MCP_SERVERS=
